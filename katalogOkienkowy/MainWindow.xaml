<Window x:Class="katalogOkienkowy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:katalogOkienkowy"
        mc:Ignorable="d"
        Title="Katalog Okienkowy" Height="600" Width="800">
    <StackPanel x:Name="GlownyStackPanel" Margin="20, 20, 20, 20">
        <TextBlock Text="Katalog Okienkowy"
                   FontSize="24"
                   FontWeight="Bold"/>
        <TextBlock 
           x:Name="EtykietaLiczbaProduktow"
           Text="Produktów 0"
           FontSize="14"
           Margin="0,10,0,0"
         />
        <TextBlock
             x:Name="EtykietaWartoscProduktow"
             Text="Wartość magazynu: 0"
             FontSize="14"
             Margin="0,10,0,0" />

    </StackPanel>
</Window>
